rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Single read check: cached for the entire evaluation duration
    function isFirmAdmin(firmId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/Firms/$(firmId)) &&
         get(/databases/$(database)/documents/Firms/$(firmId)).data.get('adminId', '') == request.auth.uid) ||
        (exists(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.get('role', '') in ['admin', 'super_admin']) ||
        (exists(/databases/$(database)/documents/Memberships/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/Memberships/$(request.auth.uid)).data.get('firmId', '') == firmId &&
         get(/databases/$(database)/documents/Memberships/$(request.auth.uid)).data.get('role', '') in ['admin', 'super_admin'])
      );
    }

    // Active member check: member status is active AND the firm status is not suspended
    function isActiveMember(firmId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/Firms/$(firmId)) &&
        get(/databases/$(database)/documents/Firms/$(firmId)).data.get('status', 'active') != 'suspended' &&
        (
          isFirmAdmin(firmId) ||
          (exists(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.get('status', '') == 'active') ||
          (exists(/databases/$(database)/documents/Memberships/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/Memberships/$(request.auth.uid)).data.get('firmId', '') == firmId &&
           (get(/databases/$(database)/documents/Memberships/$(request.auth.uid)).data.get('status', '') in ['active', 'approved']))
        );
    }

    function isConversationMember(conversationId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)/conversations/$(conversationId)) ||
        (existsAfter(/databases/$(database)/documents/Conversations/$(conversationId)) &&
         request.auth.uid in getAfter(/databases/$(database)/documents/Conversations/$(conversationId)).data.members) ||
        (exists(/databases/$(database)/documents/Conversations/$(conversationId)) &&
         request.auth.uid in get(/databases/$(database)/documents/Conversations/$(conversationId)).data.members)
      );
    }

    // Helper to evaluate conversation membership within a firm context.
    function isFirmConvMember(firmId, convData) {
      return isActiveMember(firmId) && (
        // Department channel: derived strictly from member's departmentId or headUid on department
        (convData.get('type', '') == 'department' &&
         'departmentId' in convData &&
         ((exists(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)) &&
           'departmentId' in get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data &&
           get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.departmentId != null &&
           get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.departmentId == convData.departmentId) ||
          (exists(/databases/$(database)/documents/Firms/$(firmId)/departments/$(convData.departmentId)) &&
           get(/databases/$(database)/documents/Firms/$(firmId)/departments/$(convData.departmentId)).data.get('headUid', '') == request.auth.uid))) ||
        // Direct and Project chats: caller must be in participantIds (or legacy members)
        ((convData.get('type', '') in ['direct', 'project'] || !('type' in convData)) &&
         (('participantIds' in convData && request.auth.uid in convData.participantIds) ||
          ('members' in convData && request.auth.uid in convData.members))) ||
        // All-staff channel or General team chat: all active members can read
        (convData.get('type', '') in ['allStaff', 'general'])
      );
    }

    // Safe helper to check membership by conversationId without crashing if doc is missing
    function canAccessFirmConversation(firmId, conversationId) {
      return isActiveMember(firmId) && (
        conversationId == 'general' || conversationId == 'all_staff' || conversationId == firmId ||
        (exists(/databases/$(database)/documents/Firms/$(firmId)/conversations/$(conversationId)) &&
         isFirmConvMember(firmId, get(/databases/$(database)/documents/Firms/$(firmId)/conversations/$(conversationId)).data))
      );
    }

    // Helper to verify message pinning authorization
    function canPinMessage(firmId, conversationId, convData) {
      return (
        // Direct chat: either participant
        (convData.get('type', 'direct') == 'direct' || !('type' in convData)) &&
        (('participantIds' in convData && request.auth.uid in convData.participantIds) ||
         ('members' in convData && request.auth.uid in convData.members))
      ) || (
        // Department chat: department head or lead with matching departmentId
        convData.get('type', '') == 'department' && 'departmentId' in convData && (
          (exists(/databases/$(database)/documents/Firms/$(firmId)/departments/$(convData.departmentId)) &&
           get(/databases/$(database)/documents/Firms/$(firmId)/departments/$(convData.departmentId)).data.get('headUid', '') == request.auth.uid) ||
          (exists(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.get('role', '') in ['lead', 'admin', 'super_admin'] &&
           get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.get('departmentId', '') == convData.departmentId)
        )
      ) || (
        // Project group: ownerUid
        convData.get('type', '') == 'project' && convData.get('ownerUid', '') == request.auth.uid
      ) || (
        // General team chat: any active member in the firm can pin
        (conversationId == 'general' || conversationId == firmId || convData.get('type', '') == 'general') &&
        isActiveMember(firmId)
      ) || (
        // All-staff channel: leads and admins
        (convData.get('type', '') == 'allStaff') && (
          exists(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.get('role', '') in ['lead', 'admin', 'super_admin']
        )
      );
    }

    // Helper to verify @all mention permission (leads and admins only)
    function canMentionAll(firmId) {
      return isActiveMember(firmId) && (
        exists(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.get('role', '') in ['lead', 'admin', 'super_admin']
      );
    }

    // ── Users ────────────────────────────────────────────────────────────
    match /Users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      match /conversations/{conversationId} {
        allow read  : if isOwner(userId);
        allow write : if isOwner(userId) || isConversationMember(conversationId);
      }
    }

    // ── Conversations ─────────────────────────────────────────────────────
    match /Conversations/{conversationId} {
      allow read  : if isConversationMember(conversationId) &&
                       (!('firmId' in resource.data) || isActiveMember(resource.data.firmId));
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.members &&
        (!('firmId' in request.resource.data) || isActiveMember(request.resource.data.firmId));
      allow update: if isConversationMember(conversationId) &&
                       (!('firmId' in resource.data) || isActiveMember(resource.data.firmId)) &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['pinned']) ||
                        request.resource.data.pinned.size() <= 3);
      allow delete: if false;

      // ── Typing Subcollection ────────────────────
      match /typing/{typingUid} {
        allow read: if isConversationMember(conversationId);
        allow write: if isSignedIn() && request.auth.uid == typingUid && isConversationMember(conversationId);
      }

      // ── Reads Subcollection ─────────────────────
      match /reads/{readUid} {
        allow read: if isConversationMember(conversationId);
        allow write: if isConversationMember(conversationId) && (
          request.auth.uid == readUid ||
          ((resource == null || !exists(/databases/$(database)/documents/Conversations/$(conversationId)/reads/$(readUid))) &&
           request.resource.data.keys().hasOnly(['hasMention']) &&
           request.resource.data.hasMention == true) ||
          (resource != null &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasMention']) &&
           request.resource.data.hasMention == true)
        );
      }

      // ── Messages ────────────────────────────────────────────────────────
      match /Messages/{messageId} {
        allow read  : if isConversationMember(conversationId) &&
                         (!('firmId' in get(/databases/$(database)/documents/Conversations/$(conversationId)).data) || 
                          isActiveMember(get(/databases/$(database)/documents/Conversations/$(conversationId)).data.firmId));
        allow create: if isConversationMember(conversationId) &&
          request.resource.data.senderId == request.auth.uid &&
          (!('firmId' in get(/databases/$(database)/documents/Conversations/$(conversationId)).data) || 
           isActiveMember(get(/databases/$(database)/documents/Conversations/$(conversationId)).data.firmId));
        allow update: if isConversationMember(conversationId) &&
          resource.data.senderId == request.auth.uid &&
          request.resource.data.senderId == resource.data.senderId &&
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'content', 'editedAt']) ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'content', 'deleted', 'editedAt']) &&
             request.resource.data.deleted == true)
          );
        allow delete: if false;
      }
    }

    // ── Firms ─────────────────────────────────────────────────────────────
    match /Firms/{firmId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        request.resource.data.status in ['trial', 'active'] &&
        request.resource.data.seatCount == 1 &&
        (request.resource.data.seatLimit == 5 || !('seatLimit' in request.resource.data)) &&
        request.resource.data.plan == 'trial' &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.adminId == request.auth.uid;

      allow update: if isFirmAdmin(firmId) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.adminId == resource.data.adminId;

      allow delete: if isFirmAdmin(firmId);

      // ── Presence Subcollection ──────────────────
      match /presence/{presenceUid} {
        allow read: if isActiveMember(firmId);
        allow write: if isSignedIn() && request.auth.uid == presenceUid && isActiveMember(firmId);
      }

      // ── Members Subcollection ──────────────────
      match /members/{memberId} {
        allow read: if isFirmAdmin(firmId) || isActiveMember(firmId) || isOwner(memberId);

        allow create: if isSignedIn() && (
          (request.auth.uid == memberId && isFirmAdmin(firmId)) ||
          (request.auth.uid == memberId &&
           request.resource.data.role in ['employee', 'lead'] &&
           request.resource.data.status == 'active')
        );

        allow update: if isFirmAdmin(firmId) &&
          request.resource.data.status in ['active', 'revoked'] &&
          request.resource.data.role in ['admin', 'lead', 'employee'] &&
          (!('departmentId' in request.resource.data) ||
           request.auth.uid != memberId ||
           (!('departmentId' in resource.data) && request.resource.data.departmentId == null) ||
           request.resource.data.departmentId == resource.data.departmentId);

        allow delete: if false;
      }

      // ── Departments Subcollection ───────────────
      match /departments/{deptId} {
        allow read: if isFirmAdmin(firmId) || isActiveMember(firmId);

        allow create: if isFirmAdmin(firmId) &&
          request.resource.data.status == 'active' &&
          request.resource.data.createdBy == request.auth.uid &&
          'conversationId' in request.resource.data &&
          existsAfter(/databases/$(database)/documents/Firms/$(firmId)/conversations/$(request.resource.data.conversationId));

        allow update: if isFirmAdmin(firmId) &&
          request.resource.data.conversationId == resource.data.conversationId &&
          request.resource.data.status in ['active', 'archived'];

        allow delete: if false;
      }

      // ── Conversations Subcollection ─────────────
      match /conversations/{conversationId} {
        allow read: if canAccessFirmConversation(firmId, conversationId);

        allow create: if isSignedIn() && (isActiveMember(firmId) || isFirmAdmin(firmId)) && (
          (request.resource.data.get('type', '') == 'general' || conversationId == 'general' || conversationId == firmId) ||
          (request.resource.data.type == 'department' &&
           isFirmAdmin(firmId) &&
           'departmentId' in request.resource.data &&
           existsAfter(/databases/$(database)/documents/Firms/$(firmId)/departments/$(request.resource.data.departmentId))) ||
          (request.resource.data.type == 'project' &&
           exists(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.role in ['lead', 'admin'] &&
           request.resource.data.ownerUid == request.auth.uid &&
           request.auth.uid in request.resource.data.participantIds) ||
          (request.resource.data.type == 'direct' &&
           request.auth.uid in request.resource.data.participantIds) ||
          (request.resource.data.type == 'allStaff' && isFirmAdmin(firmId))
        );

        allow update: if canAccessFirmConversation(firmId, conversationId) && (
          ((resource.data.get('type', '') == 'general' || conversationId == 'general' || conversationId == firmId) &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pinned'])) ||
          (resource.data.get('type', '') == 'project' &&
           resource.data.get('ownerUid', '') == request.auth.uid &&
           request.resource.data.type == 'project') ||
          (resource.data.get('type', '') in ['department', 'allStaff'] &&
           isFirmAdmin(firmId) &&
           request.resource.data.type == resource.data.type) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned']) &&
           canPinMessage(firmId, conversationId, resource.data) &&
           request.resource.data.pinned.size() <= 3) ||
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['pinned']))
        );

        allow delete: if false;

        // ── Typing Subcollection ────────────────────
        match /typing/{typingUid} {
          allow read: if canAccessFirmConversation(firmId, conversationId);
          allow write: if isSignedIn() && request.auth.uid == typingUid &&
            canAccessFirmConversation(firmId, conversationId);
        }

        // ── Reads Subcollection ─────────────────────
        match /reads/{readUid} {
          allow read: if canAccessFirmConversation(firmId, conversationId);
          allow write: if canAccessFirmConversation(firmId, conversationId) && (
            request.auth.uid == readUid ||
            ((resource == null || !exists(/databases/$(database)/documents/Firms/$(firmId)/conversations/$(conversationId)/reads/$(readUid))) &&
             request.resource.data.keys().hasOnly(['hasMention']) &&
             request.resource.data.hasMention == true) ||
            (resource != null &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasMention']) &&
             request.resource.data.hasMention == true)
          );
        }

        // ── Messages Subcollection ──────────────────
        match /messages/{messageId} {
          allow read: if canAccessFirmConversation(firmId, conversationId);

          allow create: if canAccessFirmConversation(firmId, conversationId) &&
            request.resource.data.senderId == request.auth.uid &&
            ((conversationId != 'all_staff' &&
              (!exists(/databases/$(database)/documents/Firms/$(firmId)/conversations/$(conversationId)) ||
               get(/databases/$(database)/documents/Firms/$(firmId)/conversations/$(conversationId)).data.get('type', '') != 'allStaff')) ||
             get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.role in ['admin', 'lead', 'super_admin']) &&
            (!('hasAllMention' in request.resource.data) || request.resource.data.hasAllMention != true ||
             canMentionAll(firmId));

          allow update: if canAccessFirmConversation(firmId, conversationId) &&
            resource.data.senderId == request.auth.uid &&
            request.resource.data.senderId == resource.data.senderId &&
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'content', 'editedAt']) ||
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'content', 'deleted', 'editedAt']) &&
               request.resource.data.deleted == true)
            );

          allow delete: if false;
        }
      }

      // ── Projects ────────────────────────────────
      match /projects/{projectId} {
        allow read: if isFirmAdmin(firmId) || isActiveMember(firmId);

        allow create: if isActiveMember(firmId) &&
          exists(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.role in ['lead', 'admin'] &&
          request.resource.data.ownerUid == request.auth.uid;

        allow update: if isActiveMember(firmId) && (
          resource.data.ownerUid == request.auth.uid || isFirmAdmin(firmId)
        );

        allow delete: if false;
      }

      // ── PreApprovedStaff Subcollection ──────────
      match /PreApprovedStaff/{staffDocId} {
        allow read: if isFirmAdmin(firmId) || isSignedIn();

        allow create: if isFirmAdmin(firmId) &&
          request.resource.data.role in ['admin', 'lead', 'employee'] &&
          getAfter(/databases/$(database)/documents/Firms/$(firmId)).data.seatCount == get(/databases/$(database)/documents/Firms/$(firmId)).data.seatCount + 1 &&
          getAfter(/databases/$(database)/documents/Firms/$(firmId)).data.seatCount <= get(/databases/$(database)/documents/Firms/$(firmId)).data.seatLimit;

        allow delete: if isFirmAdmin(firmId) &&
          getAfter(/databases/$(database)/documents/Firms/$(firmId)).data.seatCount == get(/databases/$(database)/documents/Firms/$(firmId)).data.seatCount - 1;

        allow update: if isSignedIn() && (
          isFirmAdmin(firmId) ||
          (request.resource.data.status == 'joined' && resource.data.status == 'invited')
        );
      }

      // ── Legacy Firm Messages Subcollection ──────
      match /Messages/{messageId} {
        allow read: if isFirmAdmin(firmId) || isActiveMember(firmId);
        allow create: if (isFirmAdmin(firmId) || isActiveMember(firmId)) && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Memberships ───────────────────────────────
    match /Memberships/{membershipId} {
      allow read: if isSignedIn() && (
        request.auth.uid == membershipId ||
        (resource != null && resource.data.uid == request.auth.uid) ||
        (resource != null && 'firmId' in resource.data && (isFirmAdmin(resource.data.firmId) || isActiveMember(resource.data.firmId)))
      );

      allow create: if isSignedIn() && (
        request.auth.uid == membershipId ||
        (request.resource.data.uid == request.auth.uid) ||
        ('firmId' in request.resource.data && isFirmAdmin(request.resource.data.firmId))
      );

      allow update: if isSignedIn() && (
        request.auth.uid == membershipId ||
        (resource != null && 'firmId' in resource.data && isFirmAdmin(resource.data.firmId)) ||
        ('firmId' in request.resource.data && isFirmAdmin(request.resource.data.firmId))
      );

      allow delete: if false;
    }
  }
}
