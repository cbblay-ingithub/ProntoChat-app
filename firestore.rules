rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Checks whether the caller is an active admin of the firm
    function isFirmAdmin(firmId) {
      return isSignedIn() && exists(/databases/$(database)/documents/Firms/$(firmId)) && (
        (exists(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.get('role', '') == 'admin') ||
        get(/databases/$(database)/documents/Firms/$(firmId)).data.get('ownerUid', '') == request.auth.uid ||
        get(/databases/$(database)/documents/Firms/$(firmId)).data.get('adminId', '') == request.auth.uid ||
        (exists(/databases/$(database)/documents/Memberships/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/Memberships/$(request.auth.uid)).data.get('firmId', '') == firmId &&
         get(/databases/$(database)/documents/Memberships/$(request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    // Active member check: member status is active AND the firm status is not suspended
    function isActiveMember(firmId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/Firms/$(firmId)) &&
        get(/databases/$(database)/documents/Firms/$(firmId)).data.get('status', 'active') != 'suspended' &&
        (
          isFirmAdmin(firmId) ||
          (exists(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.get('status', '') == 'active') ||
          (exists(/databases/$(database)/documents/Memberships/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/Memberships/$(request.auth.uid)).data.get('firmId', '') == firmId &&
           (get(/databases/$(database)/documents/Memberships/$(request.auth.uid)).data.get('status', '') in ['active', 'approved']))
        );
    }

    function isConversationMember(conversationId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)/conversations/$(conversationId)) ||
        (existsAfter(/databases/$(database)/documents/Conversations/$(conversationId)) &&
         request.auth.uid in getAfter(/databases/$(database)/documents/Conversations/$(conversationId)).data.members) ||
        (exists(/databases/$(database)/documents/Conversations/$(conversationId)) &&
         request.auth.uid in get(/databases/$(database)/documents/Conversations/$(conversationId)).data.members)
      );
    }

    // Helper to evaluate conversation membership within a firm context.
    // NOTE: Admin role grants NO conversation or message read access.
    function isFirmConvMember(firmId, convData) {
      return isActiveMember(firmId) && (
        // Department channel: derived strictly from member's departmentId or headUid on department
        (convData.type == 'department' &&
         'departmentId' in convData &&
         ((exists(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)) &&
           'departmentId' in get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data &&
           get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.departmentId != null &&
           get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.departmentId == convData.departmentId) ||
          (exists(/databases/$(database)/documents/Firms/$(firmId)/departments/$(convData.departmentId)) &&
           get(/databases/$(database)/documents/Firms/$(firmId)/departments/$(convData.departmentId)).data.get('headUid', '') == request.auth.uid))) ||
        // Direct and Project chats: caller must be in participantIds (or legacy members)
        ((convData.type == 'direct' || convData.type == 'project' || !('type' in convData)) &&
         (('participantIds' in convData && request.auth.uid in convData.participantIds) ||
          ('members' in convData && request.auth.uid in convData.members))) ||
        // All-staff channel: all active members can read
        (convData.type == 'allStaff')
      );
    }

    // ── Users ────────────────────────────────────────────────────────────
    match /Users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      match /conversations/{conversationId} {
        allow read  : if isOwner(userId);
        allow write : if isOwner(userId) || isConversationMember(conversationId);
      }
    }

    // ── Conversations ─────────────────────────────────────────────────────
    match /Conversations/{conversationId} {
      allow read  : if isConversationMember(conversationId) &&
                       (!('firmId' in resource.data) || isActiveMember(resource.data.firmId));
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.members &&
        (!('firmId' in request.resource.data) || isActiveMember(request.resource.data.firmId));
      allow update: if isConversationMember(conversationId) &&
                       (!('firmId' in resource.data) || isActiveMember(resource.data.firmId));
      allow delete: if false;

      // ── Messages ────────────────────────────────────────────────────────
      match /Messages/{messageId} {
        allow read  : if isConversationMember(conversationId) &&
                         (!('firmId' in get(/databases/$(database)/documents/Conversations/$(conversationId)).data) || 
                          isActiveMember(get(/databases/$(database)/documents/Conversations/$(conversationId)).data.firmId));
        allow create: if isConversationMember(conversationId) &&
          request.resource.data.senderId == request.auth.uid &&
          (!('firmId' in get(/databases/$(database)/documents/Conversations/$(conversationId)).data) || 
           isActiveMember(get(/databases/$(database)/documents/Conversations/$(conversationId)).data.firmId));
        allow update: if isConversationMember(conversationId);
        allow delete: if false;
      }
    }

    // ── Firms ─────────────────────────────────────────────────────────────
    match /Firms/{firmId} {
      // Allow reading firm public details (name, branding) for invite badges and joined users
      allow read: if true;

      // Firm creation rule (enforces Part A specs):
      // - Caller's email must be verified
      // - New firm must start as plan "trial" with default limit (5) and seatCount (1)
      // - Caller is the owner and only admin
      // - Single firm per account: verified via user record
      // - Admin membership must be created in the same batched write
      allow create: if isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.resource.data.plan == 'trial' &&
        request.resource.data.status == 'active' &&
        request.resource.data.seatLimit == 5 &&
        request.resource.data.seatCount == 1 &&
        (request.resource.data.ownerUid == request.auth.uid || request.resource.data.adminId == request.auth.uid) &&
        request.resource.data.termsAcceptedAt != null &&
        (!exists(/databases/$(database)/documents/Users/$(request.auth.uid)) ||
         !('ownedFirmId' in get(/databases/$(database)/documents/Users/$(request.auth.uid)).data) ||
         get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.ownedFirmId == firmId) &&
        existsAfter(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.role == 'admin' &&
        getAfter(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.status == 'active';

      // Updates by Firm Admin (cannot alter plan, seatLimit, or owner without billing)
      allow update: if isFirmAdmin(firmId) &&
        request.resource.data.plan == resource.data.plan &&
        request.resource.data.seatLimit == resource.data.seatLimit &&
        (request.resource.data.ownerUid == resource.data.ownerUid || request.resource.data.adminId == resource.data.adminId);

      allow delete: if isFirmAdmin(firmId);

      // ── Members Subcollection ──────────────────
      match /members/{memberId} {
        allow read: if isFirmAdmin(firmId) || isActiveMember(firmId) || isOwner(memberId);

        // Created during onboarding or firm creation
        allow create: if isSignedIn() && (
          (request.auth.uid == memberId && isFirmAdmin(firmId)) ||
          (request.auth.uid == memberId &&
           request.resource.data.role in ['employee', 'lead'] &&
           request.resource.data.status == 'active')
        );

        // Role-checked admin updates (e.g. revoking, restoring, assigning departments or roles)
        // DECISION 3: Only admins assign departments.
        // DECISION: Admin may NOT change their own departmentId. Employees and leads cannot change it at all.
        allow update: if isFirmAdmin(firmId) &&
          request.resource.data.status in ['active', 'revoked'] &&
          request.resource.data.role in ['admin', 'lead', 'employee'] &&
          (!('departmentId' in request.resource.data) ||
           request.auth.uid != memberId ||
           (!('departmentId' in resource.data) && request.resource.data.departmentId == null) ||
           request.resource.data.departmentId == resource.data.departmentId);

        allow delete: if false;
      }

      // ── Departments Subcollection ───────────────
      match /departments/{deptId} {
        allow read: if isFirmAdmin(firmId) || isActiveMember(firmId);

        // Admin only. Creating a department also creates its conversation in the same batched write.
        allow create: if isFirmAdmin(firmId) &&
          request.resource.data.status == 'active' &&
          request.resource.data.createdBy == request.auth.uid &&
          'conversationId' in request.resource.data &&
          existsAfter(/databases/$(database)/documents/Firms/$(firmId)/conversations/$(request.resource.data.conversationId));

        // Admin can rename, set head label, or archive
        allow update: if isFirmAdmin(firmId) &&
          request.resource.data.conversationId == resource.data.conversationId &&
          request.resource.data.status in ['active', 'archived'];

        allow delete: if false;
      }

      // ── Conversations Subcollection ─────────────
      match /conversations/{conversationId} {
        // DECISION 4: Admins must NOT be able to read message content in any conversation
        // they are not a real participant in. Admin role must NEVER appear as a grant here.
        allow read: if isFirmConvMember(firmId, resource.data);

        allow create: if isSignedIn() && (isActiveMember(firmId) || isFirmAdmin(firmId)) && (
          // Department conversation: created in batch with department by admin
          (request.resource.data.type == 'department' &&
           isFirmAdmin(firmId) &&
           'departmentId' in request.resource.data &&
           existsAfter(/databases/$(database)/documents/Firms/$(firmId)/departments/$(request.resource.data.departmentId))) ||

          // Project conversation: allowed for role 'lead' or 'admin'; caller must be ownerUid and participant
          (request.resource.data.type == 'project' &&
           exists(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.role in ['lead', 'admin'] &&
           request.resource.data.ownerUid == request.auth.uid &&
           request.auth.uid in request.resource.data.participantIds) ||

          // Direct conversation: caller must be in participantIds
          (request.resource.data.type == 'direct' &&
           request.auth.uid in request.resource.data.participantIds) ||

          // All-staff channel: created with firm setup or backfilled by admin
          (request.resource.data.type == 'allStaff' && isFirmAdmin(firmId))
        );

        allow update: if isActiveMember(firmId) && (
          // Project conversation: owner may add/remove participants, archive, or transfer ownership
          (resource.data.type == 'project' &&
           resource.data.ownerUid == request.auth.uid &&
           request.resource.data.type == 'project') ||

          // Department or allStaff channel metadata updates by admin
          (resource.data.type in ['department', 'allStaff'] &&
           isFirmAdmin(firmId) &&
           request.resource.data.type == resource.data.type) ||

          // Participants can update conversation previews/timestamps
          (isFirmConvMember(firmId, resource.data))
        );

        allow delete: if false;

        // ── Messages Subcollection ──────────────────
        match /messages/{messageId} {
          allow read: if isFirmConvMember(firmId, get(/databases/$(database)/documents/Firms/$(firmId)/conversations/$(conversationId)).data);

          allow create: if isFirmConvMember(firmId, get(/databases/$(database)/documents/Firms/$(firmId)/conversations/$(conversationId)).data) &&
            request.resource.data.senderId == request.auth.uid &&
            // allStaff channel: all active members read; ONLY admins and leads post
            (get(/databases/$(database)/documents/Firms/$(firmId)/conversations/$(conversationId)).data.type != 'allStaff' ||
             get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.role in ['admin', 'lead']);

          allow update, delete: if false;
        }
      }

      // ── Projects (Metadata-only oversight collection) ──
      match /projects/{projectId} {
        // Admin sees metadata only (group existence, owner, memberCount)
        allow read: if isFirmAdmin(firmId) || isActiveMember(firmId);

        allow create: if isActiveMember(firmId) &&
          exists(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.role in ['lead', 'admin'] &&
          request.resource.data.ownerUid == request.auth.uid;

        allow update: if isActiveMember(firmId) && (
          resource.data.ownerUid == request.auth.uid || isFirmAdmin(firmId)
        );

        allow delete: if false;
      }

      // ── PreApprovedStaff Subcollection ──────────
      match /PreApprovedStaff/{staffDocId} {
        allow read: if isFirmAdmin(firmId) || isSignedIn();

        // Enforce seatLimit: batch must increment seatCount by 1 and remain <= seatLimit
        allow create: if isFirmAdmin(firmId) &&
          request.resource.data.role in ['admin', 'lead', 'employee'] &&
          getAfter(/databases/$(database)/documents/Firms/$(firmId)).data.seatCount == get(/databases/$(database)/documents/Firms/$(firmId)).data.seatCount + 1 &&
          getAfter(/databases/$(database)/documents/Firms/$(firmId)).data.seatCount <= get(/databases/$(database)/documents/Firms/$(firmId)).data.seatLimit;

        // Removing staff decrements seatCount
        allow delete: if isFirmAdmin(firmId) &&
          getAfter(/databases/$(database)/documents/Firms/$(firmId)).data.seatCount == get(/databases/$(database)/documents/Firms/$(firmId)).data.seatCount - 1;

        // Updating when staff claims code during onboarding
        allow update: if isSignedIn() && (
          isFirmAdmin(firmId) ||
          (request.resource.data.status == 'joined' && resource.data.status == 'invited')
        );
      }

      // ── Legacy Firm Messages Subcollection ──────
      match /Messages/{messageId} {
        allow read: if isFirmAdmin(firmId) || isActiveMember(firmId);
        allow create: if (isFirmAdmin(firmId) || isActiveMember(firmId)) && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Memberships (Root collection backward compatibility) ───────────────
    match /Memberships/{membershipId} {
      allow read: if isSignedIn() && (
        request.auth.uid == membershipId ||
        (resource != null && resource.data.uid == request.auth.uid) ||
        (resource != null && 'firmId' in resource.data && isFirmAdmin(resource.data.firmId))
      );

      allow create: if isSignedIn() && (
        request.auth.uid == membershipId ||
        (request.resource.data.uid == request.auth.uid) ||
        ('firmId' in request.resource.data && isFirmAdmin(request.resource.data.firmId))
      );

      allow update: if isSignedIn() && (
        request.auth.uid == membershipId ||
        (resource != null && 'firmId' in resource.data && isFirmAdmin(resource.data.firmId)) ||
        ('firmId' in request.resource.data && isFirmAdmin(request.resource.data.firmId))
      );

      allow delete: if false;
    }
  }
}
