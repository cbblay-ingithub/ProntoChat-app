# ProntoChat Cloudinary Configuration
#
# DO NOT PUT ANY API KEYS OR SECRETS IN THIS FILE OR ANYWHERE IN THE APP.
# ProntoChat uses unsigned uploads directly from client to Cloudinary.
# Only the public cloud name and unsigned preset names are required.
#
# These values can be passed at build/run time via flutter `--dart-define`:
# flutter run \
#   --dart-define=CLOUDINARY_CLOUD_NAME=dj4miyael \
#   --dart-define=CLOUDINARY_PRESET_AVATAR=pc_avatar \
#   --dart-define=CLOUDINARY_PRESET_LOGO=pc_logo \
#   --dart-define=CLOUDINARY_PRESET_CHAT=pc_chat

CLOUDINARY_CLOUD_NAME=dj4miyael
CLOUDINARY_PRESET_AVATAR=pc_avatar
CLOUDINARY_PRESET_LOGO=pc_logo
CLOUDINARY_PRESET_CHAT=pc_chat
