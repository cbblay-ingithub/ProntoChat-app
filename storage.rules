rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check if the caller is the Admin of the specified firm
    function isFirmAdmin(firmId) {
      return isSignedIn() &&
        (firestore.get(/databases/(default)/documents/Firms/$(firmId)).data.ownerUid == request.auth.uid ||
         firestore.get(/databases/(default)/documents/Firms/$(firmId)).data.adminId == request.auth.uid);
    }

    // Helper to check if the user is an active member of an unsuspended firm
    function isActiveMember(firmId) {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/Firms/$(firmId)).data.status != 'suspended' &&
        ((firestore.exists(/databases/(default)/documents/Firms/$(firmId)/members/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/Firms/$(firmId)/members/$(request.auth.uid)).data.status == 'active') ||
         (firestore.exists(/databases/(default)/documents/Memberships/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/Memberships/$(request.auth.uid)).data.firmId == firmId &&
          (firestore.get(/databases/(default)/documents/Memberships/$(request.auth.uid)).data.status == 'active' ||
           firestore.get(/databases/(default)/documents/Memberships/$(request.auth.uid)).data.status == 'approved')));
    }

    // Profile Images Collection
    match /profile_images/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (fileName.startsWith(request.auth.uid));
    }

    // Firm Logos Collection
    match /firm_logos/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() &&
        isFirmAdmin(request.resource.metadata.firmId);
    }

    // Firm attachments/files (restricted to active members of active firms)
    match /firm_attachments/{firmId}/{fileName} {
      allow read: if isActiveMember(firmId);
      allow write: if isActiveMember(firmId);
    }
  }
}
